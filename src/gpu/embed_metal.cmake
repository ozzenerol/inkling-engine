# Writes OUT: a .cpp defining ink::gpu::embedded_kernels() from the .metal files in SOURCES.
set(body "#include \"gpu/context.h\"\nnamespace ink::gpu {\nconst std::vector<std::pair<std::string, std::string>>& embedded_kernels() {\n  static const std::vector<std::pair<std::string, std::string>> k = {\n")
string(REPLACE "@@" ";" SOURCES "${SOURCES}")
list(SORT SOURCES)
foreach(src ${SOURCES})
  get_filename_component(name ${src} NAME_WE)
  file(READ ${src} text)
  # Raw string literals are limited per piece by some compilers; split every 8000 chars.
  string(LENGTH "${text}" len)
  set(pieces "")
  set(pos 0)
  while(pos LESS len)
    string(SUBSTRING "${text}" ${pos} 8000 chunk)
    string(APPEND pieces "R\"INKMETAL(${chunk})INKMETAL\"\n")
    math(EXPR pos "${pos} + 8000")
  endwhile()
  string(APPEND body "    {\"${name}\", std::string(\n${pieces})},\n")
endforeach()
string(APPEND body "  };\n  return k;\n}\n}  // namespace ink::gpu\n")
file(WRITE ${OUT} "${body}")
